{
admin off
email {$ACME_EMAIL:admin@shard.network}
}
{$DISCOVERY_DOMAIN:discovery.shard.network} {
encode gzip zstd
header {
Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
X-Content-Type-Options "nosniff"
X-Frame-Options "DENY"
Referrer-Policy "strict-origin-when-cross-origin"
}
reverse_proxy shard-discovery:8080 {
health_uri /v1/discovery/health
health_interval 10s
