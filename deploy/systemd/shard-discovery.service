[Unit]
Description=SHARD Network Discovery Service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=shard
Group=shard
StateDirectory=shard/discovery
StateDirectoryMode=0700
RuntimeDirectory=shard-discovery
RuntimeDirectoryMode=0700
Environment=SHARD_DATA_DIR=/var/lib/shard/discovery
Environment=SHARD_HOST=0.0.0.0
Environment=SHARD_PORT=8090
Environment=SHARD_DISCOVERY_PORT=8090
Environment=SHARD_NO_BROWSER=1
EnvironmentFile=-/etc/default/shard-discovery
ExecStart=/usr/local/bin/shard network discovery-serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/var/lib/shard/discovery
[Install]
WantedBy=multi-user.target