FROM python:3.12-slim
WORKDIR /app
RUN groupadd -g 10001 -r shard && useradd -u 10001 -g 10001 -r -m -d /home/shard -s /usr/sbin/nologin shard && mkdir -p /data/shard && chown -R 10001:10001 /data/shard && chmod 0700 /data/shard
RUN pip install --no-cache-dir "fastapi>=0.100.0" "uvicorn>=0.22.0" "requests>=2.28.0" "psutil>=5.9.0" "pydantic>=2.0.0" "cryptography>=42.0" "websockets>=12.0"
COPY pyproject.toml setup.py README.md ./
COPY shard_engine ./shard_engine
RUN pip install --no-cache-dir --no-deps .
ENV SHARD_DATA_DIR=/data/shard
ENV SHARD_HOST=0.0.0.0
ENV SHARD_NO_BROWSER=1
ENV SHARD_DOCKER=1
ENV TMPDIR=/tmp
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8090 8091
ENTRYPOINT ["shard", "network"]
CMD ["discovery-serve"]